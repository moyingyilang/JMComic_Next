<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface">

    <!-- 顶部个人信息栏（保留优化版，简洁适配） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/m3_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <!-- 圆形头像 -->
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_launcher_round"
            android:scaleType="centerCrop"
            android:background="@drawable/avatar_circle_bg"/>

        <!-- 昵称区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JM漫友"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击编辑个人信息"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.8"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 核心功能列表【严格按你的顺序排列：9个选项】 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_white_bg"
        android:elevation="2dp">

        <!-- 1. 我的收藏 -->
        <LinearLayout
            android:id="@+id/ll_collect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="我的收藏"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 2. 标签收藏 -->
        <LinearLayout
            android:id="@+id/ll_tag_collect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="标签收藏"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 3. 信箱 -->
        <LinearLayout
            android:id="@+id/ll_mailbox"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="信箱"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 4. 追踪连载 -->
        <LinearLayout
            android:id="@+id/ll_track_serial"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="追踪连载"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 5. 成就任务 -->
        <LinearLayout
            android:id="@+id/ll_achievement"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="成就任务"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 6. 签到活动 -->
        <LinearLayout
            android:id="@+id/ll_sign_in"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="签到活动"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 7. 观看记录 -->
        <LinearLayout
            android:id="@+id/ll_watch_record"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="观看记录"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 8. 留言记录 -->
        <LinearLayout
            android:id="@+id/ll_message_record"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="留言记录"
                android:textSize="16sp"
                android:textColor="@color/m3_on_surface"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/m3_divider"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>

        <!-- 9. 设置（保留和设置页的联动逻辑） -->
        <TextView
            android:id="@+id/tv_setting"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_white_bg"
            android:gravity="center_vertical|start"
            android:paddingHorizontal="16dp"
            android:text="设置"
            android:textSize="16sp"
            android:textColor="@color/black"/>
    </LinearLayout>

    <!-- 底部版本信息栏（保留，贴合项目） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JMComic_Next v1.0.0"
            android:textSize="12sp"
            android:textColor="@color/m3_on_surface"
            android:alpha="0.6"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="仅供学习交流 · 请勿商用"
            android:textSize="10sp"
            android:textColor="@color/m3_on_surface"
            android:alpha="0.4"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
